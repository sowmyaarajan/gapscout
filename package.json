{
  "name": "gapscout",
  "version": "0.1.0",
  "description": "GapScout — MCP server that finds underserved problem spaces on GitHub",
  "type": "module",
  "bin": {
    "gapscout": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-api.mjs",
    "start": "node dist/ui.js",
    "dev": "tsc --watch",
    "test:fetch": "node dist/test-fetch.js",
    "preui": "node scripts/free-port.js",
    "ui": "node dist/ui.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@octokit/rest": "^21.0.2",
    "dotenv": "^16.4.5",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
